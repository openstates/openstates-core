[project]
name = "openstates_metadata"
version = "2026.9.1"
description = "Openstates metadata"
authors = [{ name = "Alex Obaseki", email = "alex@pluralpolicy.com" }]
license = "MIT"
readme = "README.md"
requires-python = ">=3.9,<4.0"
dependencies = [
    "attr>=0.3.2,<0.4",
    "attrs>=24.2.0,<25",
]

[tool.uv.build-backend]
module-root = ""

[build-system]
requires = ["uv_build>=0.13.6,<0.14"]
build-backend = "uv_build"
